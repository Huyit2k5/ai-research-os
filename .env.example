# Generate the key as described in README.md.
CREDENTIAL_ENCRYPTION_KEY=replace_me
# Supabase > Connect > Session pooler (IPv4). Keep the query string: libpq-style require = TLS without CA verification.
# On Vercel use the Transaction pooler instead (same URL, port 6543): the session pooler's 15 clients run out across serverless instances.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
# Optional host port (default 3000). BETTER_AUTH_URL must use the same port.
# WEB_PORT=3001
BETTER_AUTH_URL=http://localhost:3000
# Optional: free OpenAlex API key (recommended on shared hosts such as Vercel, where anonymous search is rate-limited).
# OPENALEX_API_KEY=
# Documents module: file store over the S3 protocol (Cloudflare R2; any S3-compatible service works by changing these).
# S3_ENDPOINT is https://<account_id>.r2.cloudflarestorage.com (a trailing /<bucket> is accepted). Use a bucket-scoped Object Read & Write token.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: total file storage cap for the whole project, in MB (default 9000, under R2's 10 GB free tier).
# STORAGE_LIMIT_MB=9000
# Optional: email for "Quên mật khẩu". Without both, password reset is off.
# Gmail: turn on 2-Step Verification, create an App password, and write the @ in the user name as %40.
# SMTP_URL=smtps://you%40gmail.com:<16-char-app-password>@smtp.gmail.com:465
# MAIL_FROM=Research OS <you@gmail.com>
